#!/usr/bin/env bash
# Copyright (c) 2026 Voxgig Ltd, MIT License
#
# Validate @voxgig/docgen end-to-end against real SDKs from the voxgig-sdk org.
#
# For each SDK in the list:
#   1. fetch      shallow-clone the SDK repo, take its .sdk/def/<spec>
#   2. scaffold   npm create @voxgig/sdkgen@latest <name> -- --def <spec> --folder <out>
#   3. overlay    optional: scaffold-owned src/ from a local create-sdkgen checkout
#   4. target     voxgig-sdkgen target add <lang>   (docs describe the targets)
#   5. edition    voxgig-sdkgen edition add <name>  (summary, github-pages, presentation)
#   6. build      npm run build   in <out>/.sdk
#   7. generate   npm run generate
#   8. check      bin/check-docs  - does the documentation describe the model?
#   9. qa         voxgig-docgen qa - prose, local links, anchors
#  10. rerun      regenerate and compare: documentation must be byte-stable
#
# Per-phase logs land in <run-dir>/<name>.<phase>.log; a machine-readable
# summary is appended to <run-dir>/summary.log.

set -uo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

OUT_DIR_DEFAULT="${TMPDIR:-/tmp}/docgen-validate"
SPECS_DEFAULT="${REPO_DIR}/specs/default.txt"
TARGETS_DEFAULT="ts"
EDITIONS_DEFAULT="summary,github-pages,presentation"
ORG_DEFAULT="voxgig-sdk"

SCAFFOLD_TIMEOUT_DEFAULT=900
TARGET_TIMEOUT_DEFAULT=300
BUILD_TIMEOUT_DEFAULT=600
GEN_TIMEOUT_DEFAULT=1800
QA_TIMEOUT_DEFAULT=600
SCORE_TIMEOUT_DEFAULT=900
SCORE_SCOPE_DEFAULT=all
FETCH_TIMEOUT_DEFAULT=900

usage() {
  cat <<EOF
Usage: validate-docgen [options]

  --specs <file>             SDK list (default: ${SPECS_DEFAULT})
  --out <dir>                Where doc projects are created (default: ${OUT_DIR_DEFAULT})
  --cache <dir>              Where SDK repos are cloned (default: <out>/_cache)
  --run-dir <dir>            Where logs are written (default: <out>/_runs/<UTC>)
  --org <name>               GitHub org holding the SDKs (default: ${ORG_DEFAULT})
  --targets <a,b,...>        SDK targets to add (default: ${TARGETS_DEFAULT})
  --editions <a,b,...>       Editions to add (default: ${EDITIONS_DEFAULT})
  --only <a,b,...>           Run only these SDKs
  --create-sdkgen-path <dir> Overlay scaffold-owned .sdk/src from a local
                             create-sdkgen checkout. Needed while the compact
                             apidef schema migration is unreleased on npm.
  --docgen-path <dir>        Override @voxgig/docgen in <out>/.sdk with a checkout
  --no-fetch                 Require the cache to be populated already
  --no-qa                    Skip the voxgig-docgen qa phase
  --vale                     Let qa run Vale (default: --local-only)
  --no-score                 Skip the prose-score phase
  --max-density <n>          Fail an SDK whose weighted alerts per 1000 words
                             exceed <n>. Unset, the score is recorded but
                             never fails a run.
  --score-scope <s>          authored (what docgen's own gate reads) or all
                             (every rendered word, tables included).
                             Default: both, gated on ${SCORE_SCOPE_DEFAULT}.
  --no-rerun                 Skip the byte-stability phase
  --keep                     Keep existing project folders instead of removing
  --no-summary               Skip writing REPORT.md / report.json
  --scaffold-timeout <s>     (default: ${SCAFFOLD_TIMEOUT_DEFAULT})
  --target-timeout <s>       (default: ${TARGET_TIMEOUT_DEFAULT})
  --build-timeout <s>        (default: ${BUILD_TIMEOUT_DEFAULT})
  --gen-timeout <s>          (default: ${GEN_TIMEOUT_DEFAULT})
  --qa-timeout <s>           (default: ${QA_TIMEOUT_DEFAULT})
  --score-timeout <s>        (default: ${SCORE_TIMEOUT_DEFAULT})
  -h, --help

Spec list format: <name>:<repo>:<spec-file under the repo's .sdk/def/>
EOF
}

SPECS="${SPECS_DEFAULT}"
OUT_DIR="${OUT_DIR_DEFAULT}"
CACHE_DIR=""
RUN_DIR=""
ORG="${ORG_DEFAULT}"
TARGETS="${TARGETS_DEFAULT}"
EDITIONS="${EDITIONS_DEFAULT}"
ONLY=""
CREATE_SDKGEN_PATH=""
DOCGEN_PATH=""
NO_FETCH=0
NO_QA=0
VALE=0
NO_SCORE=0
MAX_DENSITY=""
SCORE_SCOPE=""
NO_RERUN=0
KEEP=0
NO_SUMMARY=0
SCAFFOLD_TIMEOUT="${SCAFFOLD_TIMEOUT_DEFAULT}"
TARGET_TIMEOUT="${TARGET_TIMEOUT_DEFAULT}"
BUILD_TIMEOUT="${BUILD_TIMEOUT_DEFAULT}"
GEN_TIMEOUT="${GEN_TIMEOUT_DEFAULT}"
QA_TIMEOUT="${QA_TIMEOUT_DEFAULT}"
SCORE_TIMEOUT="${SCORE_TIMEOUT_DEFAULT}"

while [ $# -gt 0 ]; do
  case "$1" in
    --specs)              SPECS="$2"; shift 2;;
    --out)                OUT_DIR="$2"; shift 2;;
    --cache)              CACHE_DIR="$2"; shift 2;;
    --run-dir)            RUN_DIR="$2"; shift 2;;
    --org)                ORG="$2"; shift 2;;
    --targets)            TARGETS="$2"; shift 2;;
    --editions)           EDITIONS="$2"; shift 2;;
    --only)               ONLY="$2"; shift 2;;
    --create-sdkgen-path) CREATE_SDKGEN_PATH="$2"; shift 2;;
    --docgen-path)        DOCGEN_PATH="$2"; shift 2;;
    --no-fetch)           NO_FETCH=1; shift;;
    --no-qa)              NO_QA=1; shift;;
    --vale)               VALE=1; shift;;
    --no-score)           NO_SCORE=1; shift;;
    --max-density)        MAX_DENSITY="$2"; shift 2;;
    --score-scope)        SCORE_SCOPE="$2"; shift 2;;
    --no-rerun)           NO_RERUN=1; shift;;
    --keep)               KEEP=1; shift;;
    --no-summary)         NO_SUMMARY=1; shift;;
    --scaffold-timeout)   SCAFFOLD_TIMEOUT="$2"; shift 2;;
    --target-timeout)     TARGET_TIMEOUT="$2"; shift 2;;
    --build-timeout)      BUILD_TIMEOUT="$2"; shift 2;;
    --gen-timeout)        GEN_TIMEOUT="$2"; shift 2;;
    --qa-timeout)         QA_TIMEOUT="$2"; shift 2;;
    --score-timeout)      SCORE_TIMEOUT="$2"; shift 2;;
    -h|--help)            usage; exit 0;;
    *) echo "ERROR: unknown option: $1" >&2; usage >&2; exit 2;;
  esac
done

[ -f "${SPECS}" ] || { echo "ERROR: spec list not found: ${SPECS}" >&2; exit 2; }
for tool in node npm git; do
  command -v "${tool}" >/dev/null 2>&1 || { echo "ERROR: ${tool} is required" >&2; exit 2; }
done

# `timeout` is absent on macOS, where the fallback is a Python wrapper. Check
# for it here rather than letting every phase fail with "python3: not found".
if ! command -v timeout >/dev/null 2>&1; then
  command -v python3 >/dev/null 2>&1 || {
    echo "ERROR: neither timeout(1) nor python3 is available; one is required for phase timeouts" >&2
    exit 2; }
fi

# Both overrides become symlink targets or copy sources inside the generated
# project, so a relative path would resolve against the wrong directory.
if [ -n "${CREATE_SDKGEN_PATH}" ]; then
  [ -d "${CREATE_SDKGEN_PATH}/project/standard/.sdk/src" ] || {
    echo "ERROR: --create-sdkgen-path: no project/standard/.sdk/src at ${CREATE_SDKGEN_PATH}" >&2; exit 2; }
  CREATE_SDKGEN_PATH="$(cd "${CREATE_SDKGEN_PATH}" && pwd)"
fi
if [ -n "${DOCGEN_PATH}" ]; then
  [ -d "${DOCGEN_PATH}" ] || { echo "ERROR: --docgen-path: not a directory: ${DOCGEN_PATH}" >&2; exit 2; }
  DOCGEN_PATH="$(cd "${DOCGEN_PATH}" && pwd)"
fi

mkdir -p "${OUT_DIR}"
OUT_DIR="$(cd "${OUT_DIR}" && pwd)"
[ -n "${CACHE_DIR}" ] || CACHE_DIR="${OUT_DIR}/_cache"
[ -n "${RUN_DIR}" ] || RUN_DIR="${OUT_DIR}/_runs/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "${CACHE_DIR}" "${RUN_DIR}"

SUMMARY="${RUN_DIR}/summary.log"
: > "${SUMMARY}"

RUN_TO="${REPO_DIR}/bin/run-to.py"
run_with_timeout() {
  local seconds="$1"; shift
  if command -v timeout >/dev/null 2>&1; then timeout "${seconds}" "$@"
  else python3 "${RUN_TO}" "${seconds}" "$@"; fi
}

say() { echo "$*" | tee -a "${SUMMARY}"; }

{
  echo "config specs=${SPECS}"
  echo "config out=${OUT_DIR}"
  echo "config cache=${CACHE_DIR}"
  echo "config run_dir=${RUN_DIR}"
  echo "config org=${ORG}"
  echo "config targets=${TARGETS}"
  echo "config editions=${EDITIONS}"
  echo "config create_sdkgen_path=${CREATE_SDKGEN_PATH}"
  echo "config docgen_path=${DOCGEN_PATH}"
  echo "config qa=$([ "${NO_QA}" = 1 ] && echo off || echo on)"
  echo "config vale=$([ "${VALE}" = 1 ] && echo on || echo off)"
  echo "config score=$([ "${NO_SCORE}" = 1 ] && echo off || echo on)"
  echo "config score_scope=${SCORE_SCOPE}"
  echo "config max_density=${MAX_DENSITY}"
  echo "config rerun=$([ "${NO_RERUN}" = 1 ] && echo off || echo on)"
  echo "config started=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >> "${SUMMARY}"

ONLY_SEEN=""
is_only_match() {
  [ -z "${ONLY}" ] && return 0
  local name="$1" entry
  IFS=',' read -ra wanted <<< "${ONLY}"
  for entry in "${wanted[@]}"; do
    if [ "${entry}" = "${name}" ]; then ONLY_SEEN="${ONLY_SEEN} ${name}"; return 0; fi
  done
  return 1
}

# A typo in --only must not look like a clean run over nothing.
check_only_matched() {
  [ -z "${ONLY}" ] && return 0
  local entry missing=""
  IFS=',' read -ra wanted <<< "${ONLY}"
  for entry in "${wanted[@]}"; do
    case " ${ONLY_SEEN} " in *" ${entry} "*) ;; *) missing="${missing} ${entry}";; esac
  done
  [ -z "${missing}" ] && return 0
  echo "ERROR: --only named SDKs not in ${SPECS}:${missing}" >&2
  return 1
}

# A digest of the documentation tree, used to prove regeneration is stable.
#
# The hasher is resolved once, at startup, and its absence is fatal. A fallback
# that hashes anything other than the same byte stream - the root path, say -
# produces equal digests for every run and turns this gate into a rubber stamp
# that cannot fail.
HASHER=""
for candidate in shasum sha256sum sha1sum md5sum cksum; do
  if command -v "${candidate}" >/dev/null 2>&1; then HASHER="${candidate}"; break; fi
done
if [ -z "${HASHER}" ] && [ "${NO_RERUN}" = 0 ]; then
  echo "ERROR: no content hasher found (shasum, sha256sum, sha1sum, md5sum, cksum)." >&2
  echo "       The byte-stability phase needs one. Pass --no-rerun to skip it." >&2
  exit 2
fi

# Scoring is a gate, so a missing Vale is fatal rather than a quiet skip: a
# phase that vanishes when a dependency is absent reports the same clean run
# as a phase that passed.
VALE_BIN=""
if [ "${NO_SCORE}" = 0 ]; then
  if [ -x "${REPO_DIR}/node_modules/@vvago/vale/bin/vale" ]; then
    VALE_BIN="${REPO_DIR}/node_modules/@vvago/vale/bin/vale"
  elif command -v vale >/dev/null 2>&1; then
    VALE_BIN="$(command -v vale)"
  else
    echo "ERROR: no vale binary found." >&2
    echo "       Run 'npm install' in ${REPO_DIR}, or pass --no-score." >&2
    exit 2
  fi
  case "${SCORE_SCOPE}" in
    ''|authored|all) ;;
    *) echo "ERROR: --score-scope must be 'authored' or 'all'" >&2; exit 2;;
  esac
fi

docs_digest() {
  local root="$1"
  { [ -f "${root}/SUMMARY.md" ] && cat "${root}/SUMMARY.md"
    find "${root}/docs" -type f 2>/dev/null | LC_ALL=C sort | while read -r f; do
      echo "${f#${root}/}"; cat "${f}"
    done
  } 2>/dev/null | "${HASHER}" | cut -d' ' -f1
}

# A populated cache is REFRESHED, not reused as-is. Skipping the fetch would
# pin every later run to whatever revision the first run happened to get, so
# an upstream spec change would never be validated. --no-fetch is the explicit
# opt-out, for offline use and for reproducing an earlier run.
fetch_spec() {
  local name="$1" repo="$2" file="$3" log="$4"
  local dir="${CACHE_DIR}/${repo}"
  if [ -d "${dir}/.git" ]; then
    if [ "${NO_FETCH}" = 0 ]; then
      local branch
      branch="$(git -C "${dir}" rev-parse --abbrev-ref HEAD 2>/dev/null)"
      [ -n "${branch}" ] && [ "${branch}" != "HEAD" ] || branch=main
      GIT_LFS_SKIP_SMUDGE=1 run_with_timeout "${FETCH_TIMEOUT_DEFAULT}" \
        git -C "${dir}" fetch --depth 1 origin "${branch}" >> "${log}" 2>&1 \
        && git -C "${dir}" reset --hard FETCH_HEAD >> "${log}" 2>&1 \
        || { echo "refresh failed for ${dir}" >> "${log}"; return 1; }
    fi
  else
    if [ "${NO_FETCH}" = 1 ]; then
      echo "--no-fetch: ${dir} is not a checkout" >> "${log}"; return 1
    fi
    GIT_LFS_SKIP_SMUDGE=1 run_with_timeout "${FETCH_TIMEOUT_DEFAULT}" \
      git clone --depth 1 "https://github.com/${ORG}/${repo}" "${dir}" >> "${log}" 2>&1 || return 1
  fi
  [ -f "${dir}/.sdk/def/${file}" ] || {
    echo "spec not found: ${dir}/.sdk/def/${file}" >> "${log}"; return 1; }
  echo "${dir}/.sdk/def/${file}"
}

TOTAL=0
PASSED=0

while IFS= read -r line || [ -n "${line}" ]; do
  line="${line%%#*}"; line="$(echo "${line}" | xargs)"
  [ -z "${line}" ] && continue

  name="${line%%:*}"; rest="${line#*:}"
  repo="${rest%%:*}"; specfile="${rest#*:}"
  is_only_match "${name}" || continue

  TOTAL=$((TOTAL + 1))
  folder="${OUT_DIR}/${name}"
  log_base="${RUN_DIR}/${name}"
  say "== [${name}] ${ORG}/${repo} :: ${specfile}"
  echo "sdk=${name} repo=${repo} spec=${specfile}" >> "${SUMMARY}"

  [ "${KEEP}" = 1 ] || rm -rf "${folder}"

  # 1. fetch
  say ">> [${name}] fetch"
  spec_path="$(fetch_spec "${name}" "${repo}" "${specfile}" "${log_base}.fetch.log")"
  rc=$?
  echo "${name}_fetch_rc=${rc}" >> "${SUMMARY}"
  if [ "${rc}" != 0 ] || [ -z "${spec_path}" ]; then
    say "!! [${name}] fetch FAILED"; continue
  fi

  # 2. scaffold
  say ">> [${name}] scaffold"
  (cd "${OUT_DIR}" && run_with_timeout "${SCAFFOLD_TIMEOUT}" \
    npm create @voxgig/sdkgen@latest "${name}" -- --def "${spec_path}" --folder "${folder}") \
    > "${log_base}.scaffold.log" 2>&1
  rc=$?
  echo "${name}_scaffold_rc=${rc}" >> "${SUMMARY}"
  [ "${rc}" = 0 ] || { say "!! [${name}] scaffold FAILED rc=${rc}"; continue; }

  # 3. overlay - scaffold-owned generator sources from a local checkout.
  if [ -n "${CREATE_SDKGEN_PATH}" ]; then
    say ">> [${name}] overlay create-sdkgen"
    cp -R "${CREATE_SDKGEN_PATH}/project/standard/.sdk/src/." "${folder}/.sdk/src/" \
      > "${log_base}.overlay.log" 2>&1
    echo "${name}_overlay_rc=$?" >> "${SUMMARY}"
  fi
  if [ -n "${DOCGEN_PATH}" ]; then
    rm -rf "${folder}/.sdk/node_modules/@voxgig/docgen"
    ln -s "${DOCGEN_PATH}" "${folder}/.sdk/node_modules/@voxgig/docgen"
  fi

  # 4 and 5. targets and editions.
  #
  # A failed setup command ABANDONS the SDK. check-docs derives what it expects
  # from the resulting model, so a target or edition that failed to install is
  # simply absent from the expected set: every later phase would pass while
  # never exercising the thing that was asked for.
  setup_ok=1
  IFS=',' read -ra target_list <<< "${TARGETS}"
  for target in "${target_list[@]}"; do
    say ">> [${name}] target add ${target}"
    (cd "${folder}/.sdk" && run_with_timeout "${TARGET_TIMEOUT}" \
      npx voxgig-sdkgen target add "${target}") > "${log_base}.target.${target}.log" 2>&1
    rc=$?
    echo "${name}_target_${target}_rc=${rc}" >> "${SUMMARY}"
    [ "${rc}" = 0 ] || { say "!! [${name}] target add ${target} FAILED rc=${rc}"; setup_ok=0; }
  done

  IFS=',' read -ra edition_list <<< "${EDITIONS}"
  for edition in "${edition_list[@]}"; do
    say ">> [${name}] edition add ${edition}"
    (cd "${folder}/.sdk" && run_with_timeout "${TARGET_TIMEOUT}" \
      npx voxgig-sdkgen edition add "${edition}") > "${log_base}.edition.${edition}.log" 2>&1
    rc=$?
    echo "${name}_edition_${edition}_rc=${rc}" >> "${SUMMARY}"
    [ "${rc}" = 0 ] || { say "!! [${name}] edition add ${edition} FAILED rc=${rc}"; setup_ok=0; }
  done

  [ "${setup_ok}" = 1 ] || { say "!! [${name}] FAIL (setup)"; continue; }

  # 6. build
  say ">> [${name}] build"
  (cd "${folder}/.sdk" && run_with_timeout "${BUILD_TIMEOUT}" npm run build) \
    > "${log_base}.build.log" 2>&1
  rc=$?
  echo "${name}_build_rc=${rc}" >> "${SUMMARY}"
  [ "${rc}" = 0 ] || { say "!! [${name}] build FAILED rc=${rc}"; continue; }

  # 7. generate
  say ">> [${name}] generate"
  (cd "${folder}/.sdk" && run_with_timeout "${GEN_TIMEOUT}" npm run generate) \
    > "${log_base}.generate.log" 2>&1
  rc=$?
  echo "${name}_generate_rc=${rc}" >> "${SUMMARY}"
  [ "${rc}" = 0 ] || { say "!! [${name}] generate FAILED rc=${rc}"; continue; }

  # 8. documentation checks
  say ">> [${name}] check"
  "${REPO_DIR}/bin/check-docs" --json "${folder}" > "${log_base}.check.json" 2>"${log_base}.check.log"
  rc=$?
  echo "${name}_check_rc=${rc}" >> "${SUMMARY}"
  if [ -s "${log_base}.check.json" ]; then
    counts="$(node -e '
      const r = require(process.argv[1])
      process.stdout.write((r.checks.length - r.failed) + " " + r.checks.length)
    ' "${log_base}.check.json" 2>/dev/null)"
    echo "${name}_checks_pass=${counts%% *}" >> "${SUMMARY}"
    echo "${name}_checks_total=${counts##* }" >> "${SUMMARY}"
  fi

  # 9. text QA
  if [ "${NO_QA}" = 0 ]; then
    say ">> [${name}] qa"
    qa_args=""
    [ "${VALE}" = 1 ] || qa_args="--local-only"
    (cd "${folder}" && run_with_timeout "${QA_TIMEOUT}" \
      node "${folder}/.sdk/node_modules/@voxgig/docgen/bin/voxgig-docgen" qa ${qa_args}) \
      > "${log_base}.qa.log" 2>&1
    echo "${name}_qa_rc=$?" >> "${SUMMARY}"
  fi

  # 10. prose score
  #
  # qa answers "is anything forbidden present". This asks "how is the prose
  # doing", over the same rules and the same text, as a number that can be
  # compared between releases.
  #
  # BOTH scopes are measured, because they are different questions and the
  # gap between them is itself a finding: docgen hands Vale `authored()`,
  # which strips table cells, and a generated API reference keeps the
  # vendor's schema descriptions in exactly those cells. Scoring `authored`
  # alone measures the documentation docgen WROTE and none of the
  # documentation it CARRIED THROUGH.
  if [ "${NO_SCORE}" = 0 ]; then
    say ">> [${name}] score"
    score_rc=0
    sync_flag=""
    gate_scope="${SCORE_SCOPE:-${SCORE_SCOPE_DEFAULT}}"
    for scope in authored all; do
      [ -n "${SCORE_SCOPE}" ] && [ "${SCORE_SCOPE}" != "${scope}" ] && continue
      # The gate is the scorer's own, applied to one scope. Restating the
      # comparison here would put the threshold in two places and leave the
      # shell copy untested.
      gate_arg=""
      [ -n "${MAX_DENSITY}" ] && [ "${scope}" = "${gate_scope}" ] \
        && gate_arg="--max-density ${MAX_DENSITY}"
      run_with_timeout "${SCORE_TIMEOUT}" \
        "${REPO_DIR}/bin/prose-score" --json --scope "${scope}" --vale "${VALE_BIN}" \
        ${sync_flag} ${gate_arg} "${folder}" \
        > "${log_base}.score.${scope}.json" 2>> "${log_base}.score.log"
      rc=$?
      # The rule package is pinned by URL and the sync writes into this
      # project's own styles directory, so one sync per project covers both
      # scopes. Re-syncing would fetch the identical release twice.
      sync_flag="--no-sync"
      [ "${rc}" = 0 ] || score_rc=1
      [ -s "${log_base}.score.${scope}.json" ] || { score_rc=1; continue; }
      node -e '
        const r = require(process.argv[1])
        const [name, scope] = process.argv.slice(2)
        const out = [
          ["score", r.score], ["density", r.density], ["words", r.words],
          ["errors", r.alerts.error], ["warnings", r.alerts.warning],
          ["suggestions", r.alerts.suggestion],
        ]
        process.stdout.write(out.map(([k, v]) => `${name}_${k}_${scope}=${v}`).join("\n") + "\n")
      ' "${log_base}.score.${scope}.json" "${name}" "${scope}" >> "${SUMMARY}" 2>/dev/null || score_rc=1
    done

    echo "${name}_score_rc=${score_rc}" >> "${SUMMARY}"
  fi

  # 11. byte stability - the same model must render the same documentation.
  if [ "${NO_RERUN}" = 0 ]; then
    say ">> [${name}] rerun"
    before="$(docs_digest "${folder}")"
    (cd "${folder}/.sdk" && run_with_timeout "${GEN_TIMEOUT}" npm run generate) \
      > "${log_base}.rerun.log" 2>&1
    rc=$?
    after="$(docs_digest "${folder}")"
    if [ "${rc}" != 0 ]; then
      echo "${name}_rerun_rc=${rc}" >> "${SUMMARY}"
    elif [ "${before}" = "${after}" ]; then
      echo "${name}_rerun_rc=0" >> "${SUMMARY}"
    else
      echo "${name}_rerun_rc=1" >> "${SUMMARY}"
      echo "documentation changed on regeneration: ${before} -> ${after}" >> "${log_base}.rerun.log"
    fi
  fi

  ok=1
  grep -q "^${name}_check_rc=0$" "${SUMMARY}" || ok=0
  [ "${NO_QA}" = 1 ] || grep -q "^${name}_qa_rc=0$" "${SUMMARY}" || ok=0
  [ "${NO_SCORE}" = 1 ] || grep -q "^${name}_score_rc=0$" "${SUMMARY}" || ok=0
  [ "${NO_RERUN}" = 1 ] || grep -q "^${name}_rerun_rc=0$" "${SUMMARY}" || ok=0
  if [ "${ok}" = 1 ]; then PASSED=$((PASSED + 1)); say "++ [${name}] PASS"
  else say "!! [${name}] FAIL"; fi
done < "${SPECS}"

echo "config finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "${SUMMARY}"
echo "result passed=${PASSED} total=${TOTAL}" >> "${SUMMARY}"
say "== ${PASSED}/${TOTAL} SDKs fully validated"

if [ "${NO_SUMMARY}" = 0 ]; then
  "${REPO_DIR}/bin/summarize" --run-dir "${RUN_DIR}" || true
fi

ONLY_OK=1
check_only_matched || ONLY_OK=0

# Validating nothing is not success. An empty spec list, an all-comment file or
# a mistyped --only would otherwise report "0/0" and exit clean.
if [ "${TOTAL}" = 0 ]; then
  echo "ERROR: no SDKs were selected from ${SPECS}${ONLY:+ (--only ${ONLY})}" >&2
  exit 2
fi
[ "${ONLY_OK}" = 1 ] || exit 2
[ "${PASSED}" = "${TOTAL}" ] || exit 1
exit 0
